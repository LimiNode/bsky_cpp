PROJECT_NAME           = bsky_cpp
PROJECT_NUMBER         = @PROJECT_VERSION@
PROJECT_BRIEF          = "Modern C++17 Bluesky and AT Protocol client SDK"
OUTPUT_DIRECTORY       = @BSKY_DOXYGEN_OUTPUT_DIRECTORY@
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English
INPUT                  = @CMAKE_CURRENT_SOURCE_DIR@/src/bsky_cpp.hpp \
                         @CMAKE_CURRENT_SOURCE_DIR@/src/bsky_cpp/core/bsky_error.hpp \
                         @CMAKE_CURRENT_SOURCE_DIR@/src/bsky_cpp/core/cancellation.hpp \
                         @CMAKE_CURRENT_SOURCE_DIR@/src/bsky_cpp/core/result.hpp \
                         @CMAKE_CURRENT_SOURCE_DIR@/src/bsky_cpp/core/version.hpp \
                         @CMAKE_CURRENT_SOURCE_DIR@/src/bsky_cpp/atproto/identifiers.hpp \
                         @CMAKE_CURRENT_SOURCE_DIR@/src/bsky_cpp/transport/transport.hpp
RECURSIVE              = NO
FILE_PATTERNS          = *.hpp
EXCLUDE                = @CMAKE_CURRENT_SOURCE_DIR@/src/bsky_cpp/*/detail
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = YES
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = YES
JAVADOC_AUTOBRIEF      = YES
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = @CMAKE_CURRENT_SOURCE_DIR@
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_XML           = NO
QUIET                  = NO
